# Environment Variables — AI Revenue Recovery Platform
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-secret-key-here-replace-this
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=revenue_recovery_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# Razorpay (Test Mode Only at this stage)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ---------------------------------------------------------------------------
# AI Provider (LLM-agnostic — configure the provider you intend to use)
# ---------------------------------------------------------------------------
AI_PROVIDER=openai                         # openai | anthropic | google | custom
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o                            # Model identifier for the chosen provider
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.0                         # Keep low for deterministic outputs

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                        # development | staging | production
LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# Recovery Guardrail Defaults (can be overridden per merchant policy)
# ---------------------------------------------------------------------------
DEFAULT_MAX_RETRY_ATTEMPTS=3
DEFAULT_RECOVERY_WINDOW_DAYS=7
DEFAULT_HIGH_VALUE_THRESHOLD=50000         # Amount in paise (INR 500)

# ---------------------------------------------------------------------------
# Email (for notifications — configure before enabling)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com
